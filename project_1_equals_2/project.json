  "captions": [
    {
      "start": 0.2,
      "end": 1.948,
      "text": "Thầy! Em vừa phát hiện ra một sai"
    },
    {
      "start": 1.948,
      "end": 4.12,
      "text": "lầm của toán học kéo dài hàng nghìn năm!"
    },
    {
      "start": 4.469,
      "end": 5.837,
      "text": "Lần trước em cũng nói thế"
    },
    {
      "start": 5.837,
      "end": 7.589,
      "text": "khi phát hiện máy tính hết pin."
    },
    {
      "start": 7.94,
      "end": 8.933,
      "text": "Lần này khác! Em đã"
    },
    {
      "start": 8.933,
      "end": 10.5,
      "text": "chứng minh được một bằng hai!"
    },
    {
      "start": 10.849,
      "end": 12.299,
      "text": "Thế mày có một triệu thì"
    },
    {
      "start": 12.299,
      "end": 13.81,
      "text": "bằng tao có hai triệu à?"
    },
    {
      "start": 14.16,
      "end": 14.96,
      "text": "Chính xác!"
    },
    {
      "start": 15.31,
      "end": 17.469,
      "text": "Thế trả tao hai triệu mày nợ đi."
    },
    {
      "start": 17.82,
      "end": 19.608,
      "text": "Giả sử a bằng b. Nhân hai vế với"
    },
    {
      "start": 19.608,
      "end": 21.899,
      "text": "a, ta được: a bình phương bằng a nhân b."
    },
    {
      "start": 22.25,
      "end": 23.055,
      "text": "Trừ hai vế cho b"
    },
    {
      "start": 23.055,
      "end": 24.414,
      "text": "bình phương: a bình phương"
    },
    {
      "start": 24.414,
      "end": 25.546,
      "text": "trừ b bình phương bằng"
    },
    {
      "start": 25.546,
      "end": 26.73,
      "text": "a b trừ b bình phương."
    },
    {
      "start": 27.079,
      "end": 29.288,
      "text": "Phân tích thành nhân tử: a trừ b nhân"
    },
    {
      "start": 29.288,
      "end": 31.079,
      "text": "a cộng b bằng b nhân a trừ b."
    },
    {
      "start": 31.429,
      "end": 33.022,
      "text": "Chia hai vế cho a trừ b,"
    },
    {
      "start": 33.022,
      "end": 34.549,
      "text": "ta có a cộng b bằng b."
    },
    {
      "start": 34.899,
      "end": 36.151,
      "text": "Vì a bằng b nên hai b"
    },
    {
      "start": 36.151,
      "end": 37.939,
      "text": "bằng b. Suy ra: Hai bằng một!"
    },
    {
      "start": 38.289,
      "end": 39.57,
      "text": "Toán học đã bị đánh bại!"
    },
    {
      "start": 39.92,
      "end": 41.761,
      "text": "Tao vừa chứng kiến một đứa học sinh"
    },
    {
      "start": 41.761,
      "end": 43.759,
      "text": "cấp ba xóa sổ nền văn minh nhân loại."
    },
    {
      "start": 44.109,
      "end": 44.993,
      "text": "Minh, em làm lại"
    },
    {
      "start": 44.993,
      "end": 46.429,
      "text": "bước chia này được không?"
    },
    {
      "start": 46.78,
      "end": 48.27,
      "text": "Dạ được. Hai vế cùng có a"
    },
    {
      "start": 48.27,
      "end": 49.82,
      "text": "trừ b thì chia đi thôi ạ."
    },
    {
      "start": 50.17,
      "end": 52.329,
      "text": "Nhưng ban đầu em giả sử a bằng b mà?"
    },
    {
      "start": 52.679,
      "end": 53.24,
      "text": "Vâng."
    },
    {
      "start": 53.59,
      "end": 55.35,
      "text": "Vậy a trừ b bằng bao nhiêu?"
    },
    {
      "start": 55.7,
      "end": 56.579,
      "text": "Bằng... Không."
    },
    {
      "start": 56.929,
      "end": 58.689,
      "text": "Vậy em vừa chia cho số mấy?"
    },
    {
      "start": 59.039,
      "end": 60.445,
      "text": "Em xin phép thu hồi phát"
    },
    {
      "start": 60.445,
      "end": 62.32,
      "text": "biểu về nền văn minh nhân loại."
    },
    {
      "start": 62.67,
      "end": 63.815,
      "text": "Nhưng thầy... Chỉ sai"
    },
    {
      "start": 63.815,
      "end": 65.069,
      "text": "đúng một bước thôi mà."
    },
    {
      "start": 65.42,
      "end": 66.875,
      "text": "Đúng. Và một bước đó khiến tất"
    },
    {
      "start": 66.875,
      "end": 68.62,
      "text": "cả những bước sau trở nên vô nghĩa."
    },
    {
      "start": 68.969,
      "end": 70.373,
      "text": "Em có biết điều thú vị nhất"
    },
    {
      "start": 70.373,
      "end": 72.09,
      "text": "ở chứng minh của em là gì không?"
    },
    {
      "start": 72.439,
      "end": 74.519,
      "text": "Là em suýt giành giải Nobel Toán học ạ?"
    },
    {
      "start": 74.87,
      "end": 75.898,
      "text": "Là em đã tin nó. Em"
    },
    {
      "start": 75.898,
      "end": 77.576,
      "text": "biết biến đổi biểu thức, nhưng"
    },
    {
      "start": 77.576,
      "end": 79.011,
      "text": "em chưa từng hỏi liệu phép"
    },
    {
      "start": 79.011,
      "end": 80.39,
      "text": "tính đó có hợp lệ không."
    },
    {
      "start": 80.739,
      "end": 81.85900000000001,
      "text": "Vì em thấy nó đúng..."
    },
    {
      "start": 82.209,
      "end": 83.40899999999999,
      "text": "Và em muốn nó đúng."
    },
    {
      "start": 83.76,
      "end": 85.92,
      "text": "Thế sau vụ này mày rút ra được gì?"
    },
    {
      "start": 86.269,
      "end": 87.87,
      "text": "Rằng không được chia cho không."
    },
    {
      "start": 88.219,
      "end": 88.78,
      "text": "Hết?"
    },
    {
      "start": 89.129,
      "end": 90.206,
      "text": "Không. Tao đã dành cả"
    },
    {
      "start": 90.206,
      "end": 91.386,
      "text": "buổi để tìm cách chứng"
    },
    {
      "start": 91.386,
      "end": 92.591,
      "text": "minh mình đúng, thay vì"
    },
    {
      "start": 92.591,
      "end": 93.84899999999999,
      "text": "tìm xem mình sai ở đâu."
    },
    {
      "start": 94.2,
      "end": 95.87899999999999,
      "text": "Đấy mới là điều em vừa học được."
    },
    {
      "start": 96.22999999999999,
      "end": 97.8,
      "text": "Hay đấy. Nhưng hai triệu"
    },
    {
      "start": 97.8,
      "end": 99.10900000000001,
      "text": "mày nợ tao thì sao?"
    },
    {
      "start": 99.459,
      "end": 100.496,
      "text": "Áp dụng kiến thức mới,"
    },
    {
      "start": 100.496,
      "end": 101.628,
      "text": "tao quyết định kiểm tra"
    },
    {
      "start": 101.628,
      "end": 102.687,
      "text": "lại giả thiết ban đầu:"
    },
    {
      "start": 102.687,
      "end": 103.939,
      "text": "Rằng tao có vay tiền mày!"
    },
    {
      "start": 104.28999999999999,
      "end": 106.334,
      "text": "Người học thuộc tìm cách đi đến đáp án."
    },
    {
      "start": 106.334,
      "end": 107.618,
      "text": "Người hiểu toán tìm cách"
    },
    {
      "start": 107.618,
      "end": 108.84899999999999,
      "text": "kiểm tra từng bước đi."
    }
  ],
